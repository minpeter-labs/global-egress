{
  "uid": "global-egress",
  "title": "Global Egress Proxy",
  "tags": [
    "homelab",
    "egress",
    "proxy",
    "mullvad"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 17,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "job",
        "label": "Scrape job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(global_egress_up, job)",
        "current": {
          "selected": false,
          "text": "global-egress",
          "value": "global-egress"
        },
        "definition": "label_values(global_egress_up, job)",
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "skipUrlSync": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 30,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Status",
      "description": "DOWN when the control API is unavailable, DEGRADED when success rate is below 99% or p95 setup latency exceeds 2.5 seconds.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "global_egress_up{job=\"$job\"} * scalar(1 + clamp_max(((100 * sum(global_egress_request_results_total{job=\"$job\",result=\"success\"}) / clamp_min(sum(global_egress_request_results_total{job=\"$job\"}), 1) < bool 99) * (sum(global_egress_request_results_total{job=\"$job\"}) > bool 0)) + ((histogram_quantile(0.95, sum by (le) (global_egress_request_duration_seconds_bucket{job=\"$job\",result=\"success\"})) or vector(0)) > bool 2.5), 1))",
          "refId": "A",
          "legendFormat": "up"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
          {
            "type": "value",
            "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green",
                "index": 1
              }
            }
          },
          {
            "type": "value",
            "options": {
              "2": {
                "text": "DEGRADED",
                "color": "orange",
                "index": 2
              }
            }
          }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
            {
              "color": "green",
              "value": 1
            },
            {
              "color": "orange",
              "value": 2
            }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Success rate",
      "description": "Share of proxy requests that reached an upstream successfully since the service last started.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * sum(global_egress_request_results_total{job=\"$job\",result=\"success\"}) / clamp_min(sum(global_egress_request_results_total{job=\"$job\"}), 1)",
          "instant": true,
          "range": false,
          "refId": "A",
          "legendFormat": "success"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 setup latency",
      "description": "Process-lifetime 95th percentile time from an accepted proxy request until its upstream connection or response headers are ready. Warning begins at 1 second and critical at 2.5 seconds.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (global_egress_request_duration_seconds_bucket{job=\"$job\",result=\"success\"}))",
          "instant": true,
          "range": false,
          "refId": "A",
          "legendFormat": "p95"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2.5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Entry health",
      "description": "WireGuard entry tunnels currently established. Every request travels through one of these; all three down means a total outage.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * global_egress_entries_open{job=\"$job\"} / global_egress_entries{job=\"$job\"}",
          "instant": true,
          "range": false,
          "refId": "A",
          "legendFormat": "availability"
        }
      ],
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 67
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Connections",
      "description": "Active leases and the pool-wide connection cap. Requests over the cap are refused with 503.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "global_egress_active_leases{job=\"$job\"}",
          "instant": true,
          "range": false,
          "refId": "A",
          "legendFormat": "active"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "global_egress_max_concurrent_conns{job=\"$job\"}",
          "instant": true,
          "range": false,
          "refId": "B",
          "legendFormat": "cap"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 40,
      "type": "stat",
      "title": "Tunnel budget",
      "description": "New WireGuard tunnels opened in the provider rate window and the configured budget.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "global_egress_new_tunnels_used{job=\"$job\"}",
          "instant": true,
          "range": false,
          "refId": "A",
          "legendFormat": "used"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "global_egress_new_tunnel_budget{job=\"$job\"}",
          "instant": true,
          "range": false,
          "refId": "B",
          "legendFormat": "budget"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 31,
      "type": "row",
      "title": "Traffic & routing",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      }
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Entry tunnel state",
      "description": "Per-entry availability. A drop to 0 that recovers on its own is the pool detecting a dead entry, taking it out of rotation, and re-establishing it.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "global_egress_entry_open{job=\"$job\",entry=~\".*[A-Za-z0-9].*\"}",
          "refId": "A",
          "legendFormat": "{{entry}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 70,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "auto",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request rate and failures",
      "description": "Acquisitions are slot selections, roughly one per new connection. Failures and busy refusals should stay near zero; sustained failures usually mean a dead entry rather than dead exits.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(global_egress_acquisitions{job=\"$job\"}[5m]) * 60",
          "refId": "A",
          "legendFormat": "acquisitions/min"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(global_egress_failures{job=\"$job\"}[5m]) * 60",
          "refId": "B",
          "legendFormat": "failures/min"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(global_egress_refused_busy{job=\"$job\"}[5m]) * 60",
          "refId": "C",
          "legendFormat": "busy refusals/min"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(global_egress_rotations{job=\"$job\"}[5m]) * 60",
          "refId": "D",
          "legendFormat": "rotations/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failures/min"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "busy refusals/min"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Data processed",
      "description": "Payload bytes relayed since start, counted at the proxy. The guest NIC sees proxied traffic twice, once from the client and once inside the tunnel, so interface counters read roughly double this.",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 8,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "global_egress_bytes_received_total{job=\"$job\"}",
          "refId": "A",
          "legendFormat": "downloaded"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "global_egress_bytes_sent_total{job=\"$job\"}",
          "refId": "B",
          "legendFormat": "uploaded"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Proxy throughput",
      "description": "Payload actually relayed, as opposed to what crosses the guest interface.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(global_egress_bytes_received_total{job=\"$job\"}[5m]) * 8",
          "refId": "A",
          "legendFormat": "download"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(global_egress_bytes_sent_total{job=\"$job\"}[5m]) * 8",
          "refId": "B",
          "legendFormat": "upload"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Traffic by entry tunnel",
      "description": "Which entry is carrying the load. One entry taking everything usually means the others lost their latency race, or that they are failing and being skipped.",
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 14,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(global_egress_entry_bytes_received_total{job=\"$job\",entry=~\".*[A-Za-z0-9].*\"}[5m]) * 8",
          "refId": "A",
          "legendFormat": "{{entry}} ({{region}}) down"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(global_egress_entry_bytes_sent_total{job=\"$job\",entry=~\".*[A-Za-z0-9].*\"}[5m]) * 8",
          "refId": "B",
          "legendFormat": "{{entry}} ({{region}}) up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 44,
      "type": "bargauge",
      "title": "Failure reasons",
      "description": "Non-successful proxy requests by reason since the service last started.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (result) (global_egress_request_results_total{job=\"$job\",result!=\"success\"})",
          "instant": true,
          "range": false,
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      }
    },
    {
      "id": 45,
      "type": "bargauge",
      "title": "Entry p95 setup latency",
      "description": "Successful request setup latency by the entry tunnel that carried the request. Warning begins at 1 second and critical at 2.5 seconds.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, entry) (global_egress_request_duration_seconds_bucket{job=\"$job\",result=\"success\",entry!=\"none\"}))",
          "instant": true,
          "range": false,
          "refId": "A",
          "legendFormat": "{{entry}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
